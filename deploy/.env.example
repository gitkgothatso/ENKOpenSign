# ENK Sign instance settings. `bin/enk-sign init` copies this to .env and fills in the generated secrets.
# Keep .env out of git: it holds the master key and the signing certificate.
# Docker Compose expands $ in values: wrap any value containing $ in single quotes, e.g. SMTP_PASS='pa$$word'.

# ── Release ──────────────────────────────────────────────────────────────────
# Image tag to run (a GitHub release of gitkgothatso/ENKOpenSign). Changed by `bin/enk-sign upgrade`.
ENK_VERSION=v0.0.1-enk.0
# ENK_REGISTRY=ghcr.io/gitkgothatso

# ── Address ──────────────────────────────────────────────────────────────────
# Public URL users open, without a trailing slash.
PUBLIC_URL=https://sign.example.com
# What Caddy serves: the bare domain for automatic Let's Encrypt certificates.
SITE_ADDRESS=sign.example.com
# Optional TLS directive. On-prem without public DNS: "tls internal".
# Client certificate: put files in config/certs/ and use "tls /certs/cert.pem /certs/key.pem".
CADDY_TLS=
# HTTP_PORT=80
# HTTPS_PORT=443

# ── Branding ─────────────────────────────────────────────────────────────────
# Put logo.svg, favicon.svg and theme.css in config/brand/; they are served at /brand/.
BRAND_NAME=
BRAND_LOGO_URL=
BRAND_FAVICON_URL=
# Absolute URL (emails are read outside the app), e.g. https://sign.example.com/brand/logo.png
EMAIL_LOGO_URL=
SUPPORT_EMAIL=
# Spam-complaint address shown in the footer of signing emails.
COMPLAINTS_EMAIL=
HIDE_SOCIAL=true
# Source of this build, linked from the footer (AGPL-3.0 section 13).
SOURCE_URL=https://github.com/gitkgothatso/ENKOpenSign

# ── Secrets (generated by `bin/enk-sign init`) ───────────────────────────────
MASTER_KEY=
# Base64 of the PKCS#12 certificate used to digitally sign completed documents, and its passphrase.
PFX_BASE64=
PASS_PHRASE=

# ── Email ────────────────────────────────────────────────────────────────────
# SMTP (SES, Microsoft 365, the client's relay, ...). Port 465 uses implicit TLS, others STARTTLS.
SMTP_ENABLE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_USER_EMAIL=
SMTP_PASS=
# Or Mailgun: set SMTP_ENABLE=false and fill these.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_SENDER=

# ── Document storage ─────────────────────────────────────────────────────────
# true: documents stay on this host in the `files` volume (included in `bin/enk-sign backup`).
# false: S3 / DigitalOcean Spaces, configured below.
USE_LOCAL=true
DO_SPACE=
DO_ENDPOINT=
DO_BASEURL=
DO_ACCESS_KEY_ID=
DO_SECRET_ACCESS_KEY=
DO_REGION=

# ── Backups ──────────────────────────────────────────────────────────────────
# Optional: `bin/enk-sign backup` also copies each backup here (needs the aws CLI on the host).
# BACKUP_S3_URI=s3://acme-sign-backups/prod

# ── Fixed values (do not change) ─────────────────────────────────────────────
APP_ID=opensign

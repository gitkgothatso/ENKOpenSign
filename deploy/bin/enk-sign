#!/usr/bin/env bash
# enk-sign: install and operate one ENK Sign instance (cloud VM or on-prem server).
# Run from anywhere; it always works on the deploy/ directory that contains it.
set -euo pipefail

DEPLOY_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$DEPLOY_DIR"

COMPOSE=(docker compose -f docker-compose.prod.yml)
ENV_FILE=.env
PREV_FILE=.enk-previous-version
BACKUP_ROOT=backups
TEMPLATE_FILES=(
  password_reset_email.html password_reset_email.txt password_reset_email_subject.txt
  verification_email.html verification_email.txt verification_email_subject.txt
)

die() { echo "error: $*" >&2; exit 1; }
info() { echo "==> $*"; }

env_get() { grep -E "^$1=" "$ENV_FILE" | tail -1 | cut -d= -f2- | sed -E "s/^['\"](.*)['\"]$/\1/"; }

env_set() {
  local key=$1 value=$2 tmp
  tmp=$(mktemp)
  if grep -qE "^$key=" "$ENV_FILE"; then
    awk -v k="$key" -v v="$value" 'BEGIN{FS=OFS="="} $1==k {print k "=" v; next} {print}' "$ENV_FILE" >"$tmp"
  else
    cat "$ENV_FILE" >"$tmp" && echo "$key=$value" >>"$tmp"
  fi
  cat "$tmp" >"$ENV_FILE" && rm -f "$tmp"
}

require_env() { [[ -f $ENV_FILE ]] || die "no $ENV_FILE yet; run: $0 init"; }

server_image() { echo "$(env_get ENK_REGISTRY | sed 's#^$#ghcr.io/gitkgothatso#')/enk-sign-server:$(env_get ENK_VERSION)"; }

check_config() {
  local missing=() key
  for key in ENK_VERSION PUBLIC_URL SITE_ADDRESS MASTER_KEY PFX_BASE64 PASS_PHRASE; do
    [[ -n "$(env_get "$key")" ]] || missing+=("$key")
  done
  ((${#missing[@]} == 0)) || die "set these in $ENV_FILE: ${missing[*]}"
  [[ "$(env_get PUBLIC_URL)" != "https://sign.example.com" ]] || die "PUBLIC_URL is still the example value"
  [[ "$(env_get PUBLIC_URL)" != */ ]] || die "PUBLIC_URL must not end with /"
}

# Default email templates come from the server image the first time; edit them in config/email/ afterwards.
ensure_templates() {
  mkdir -p config/email
  local f missing=()
  for f in "${TEMPLATE_FILES[@]}"; do [[ -f config/email/$f ]] || missing+=("$f"); done
  ((${#missing[@]} == 0)) && return
  info "copying default email templates from $(server_image) into config/email/"
  docker image inspect "$(server_image)" >/dev/null 2>&1 || docker pull "$(server_image)"
  local cid
  cid=$(docker create "$(server_image)")
  for f in "${missing[@]}"; do docker cp "$cid:/usr/src/app/files/$f" "config/email/$f"; done
  docker rm "$cid" >/dev/null
}

cmd_init() {
  [[ -f $ENV_FILE ]] && die "$ENV_FILE already exists; edit it directly"
  command -v openssl >/dev/null || die "openssl is required"
  cp .env.example "$ENV_FILE"
  chmod 600 "$ENV_FILE"
  mkdir -p config/brand config/email config/certs "$BACKUP_ROOT"

  env_set MASTER_KEY "$(openssl rand -hex 24)"

  local name tmp pass
  name=$(env_get BRAND_NAME); name=${name:-ENK Sign}
  tmp=$(mktemp -d)
  pass=$(openssl rand -hex 16)
  openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
    -keyout "$tmp/key.pem" -out "$tmp/cert.pem" -subj "/CN=$name/O=$name" 2>/dev/null
  openssl pkcs12 -export -inkey "$tmp/key.pem" -in "$tmp/cert.pem" \
    -out "$tmp/sign.p12" -passout "pass:$pass"
  env_set PFX_BASE64 "$(base64 -w0 "$tmp/sign.p12")"
  env_set PASS_PHRASE "$pass"
  rm -rf "$tmp"

  info "created $ENV_FILE with a new master key and a self-signed document signing certificate"
  echo "Next: edit $ENV_FILE (PUBLIC_URL, SITE_ADDRESS, BRAND_NAME, email), add branding to config/brand/,"
  echo "      then run: $0 up && $0 create-admin"
}

cmd_up() {
  require_env; check_config; ensure_templates
  info "starting $(env_get ENK_VERSION)"
  "${COMPOSE[@]}" up -d --wait
  "${COMPOSE[@]}" ps
}

cmd_down() { require_env; "${COMPOSE[@]}" down; }
cmd_status() { require_env; echo "version: $(env_get ENK_VERSION)"; "${COMPOSE[@]}" ps; }
cmd_logs() { require_env; "${COMPOSE[@]}" logs -f --tail=200 "$@"; }

cmd_backup() {
  require_env
  local dir="$BACKUP_ROOT/$(date -u +%Y%m%dT%H%M%SZ)-$(env_get ENK_VERSION)"
  mkdir -p "$dir"
  info "backing up database to $dir/mongo.archive.gz"
  "${COMPOSE[@]}" exec -T mongo mongodump --quiet --archive --gzip --db OpenSignDB >"$dir/mongo.archive.gz"
  info "backing up uploaded documents to $dir/files.tar.gz"
  "${COMPOSE[@]}" exec -T server tar czf - -C /usr/src/app/files files >"$dir/files.tar.gz"
  tar czf "$dir/config.tar.gz" "$ENV_FILE" config
  chmod -R go-rwx "$dir"
  if [[ -n "$(env_get BACKUP_S3_URI)" ]]; then
    info "uploading to $(env_get BACKUP_S3_URI)"
    aws s3 cp --recursive "$dir" "$(env_get BACKUP_S3_URI)/$(basename "$dir")"
  fi
  echo "$dir"
}

cmd_restore() {
  require_env
  local dir=${1:-}
  [[ -n $dir && -f $dir/mongo.archive.gz ]] || die "usage: $0 restore <backup dir>   (see $BACKUP_ROOT/)"
  read -r -p "Replace the current database and documents with $dir? [y/N] " ok
  [[ $ok == [yY] ]] || die "aborted"
  info "restoring database"
  "${COMPOSE[@]}" exec -T mongo mongorestore --quiet --drop --archive --gzip --nsInclude 'OpenSignDB.*' <"$dir/mongo.archive.gz"
  if [[ -f $dir/files.tar.gz ]]; then
    info "restoring uploaded documents"
    "${COMPOSE[@]}" exec -T server sh -c 'rm -rf /usr/src/app/files/files/* && tar xzf - -C /usr/src/app/files' <"$dir/files.tar.gz"
  fi
  "${COMPOSE[@]}" restart server
  info "restored from $dir"
}

cmd_upgrade() {
  require_env
  local target=${1:-} current
  [[ -n $target ]] || die "usage: $0 upgrade <version>   e.g. v1.2.0-enk.1"
  current=$(env_get ENK_VERSION)
  [[ $target != "$current" ]] || die "already on $current"
  info "backing up before upgrading $current -> $target"
  cmd_backup >/dev/null
  echo "$current" >"$PREV_FILE"
  env_set ENK_VERSION "$target"
  if ! "${COMPOSE[@]}" up -d --wait; then
    echo "Upgrade to $target did not become healthy. Roll back with: $0 rollback" >&2
    exit 1
  fi
  info "now on $target (database migrations run automatically at server start)"
}

cmd_rollback() {
  require_env
  [[ -f $PREV_FILE ]] || die "no previous version recorded"
  local prev
  prev=$(cat "$PREV_FILE")
  info "switching back to $prev"
  env_set ENK_VERSION "$prev"
  "${COMPOSE[@]}" up -d --wait
  rm -f "$PREV_FILE"
  echo "If the newer version migrated the database, also restore the pre-upgrade backup:"
  echo "  $0 restore $(ls -1d "$BACKUP_ROOT"/* 2>/dev/null | tail -1)"
}

# First administrator, created with the app's own `addadmin` function so the
# organisation and "All Users" team are set up exactly as the /addadmin page does.
cmd_create_admin() {
  require_env
  local name email company password password2
  read -r -p "Admin name: " name
  read -r -p "Admin email: " email
  read -r -p "Organisation name: " company
  read -r -s -p "Password: " password; echo
  read -r -s -p "Repeat password: " password2; echo
  [[ -n $name && -n $email && -n $company && -n $password ]] || die "all fields are required"
  [[ $password == "$password2" ]] || die "passwords do not match"

  NAME=$name EMAIL=$email COMPANY=$company PASSWORD=$password \
    "${COMPOSE[@]}" exec -T -e NAME -e EMAIL -e COMPANY -e PASSWORD server node --input-type=module -e '
const base = "http://localhost:8080/app/functions";
const headers = {
  "Content-Type": "application/json",
  "X-Parse-Application-Id": process.env.APP_ID || "opensign",
  "X-Parse-Master-Key": process.env.MASTER_KEY,
};
const call = async (fn, body = {}) => {
  const res = await fetch(`${base}/${fn}`, { method: "POST", headers, body: JSON.stringify(body) });
  const json = await res.json();
  if (!res.ok) throw new Error(json.error || res.statusText);
  return json.result;
};
if ((await call("checkadminexist")) === "exist") {
  console.error("An administrator already exists; add more users from Settings > Users.");
  process.exit(1);
}
const result = await call("addadmin", {
  userDetails: {
    name: process.env.NAME,
    email: process.env.EMAIL,
    company: process.env.COMPANY,
    password: process.env.PASSWORD,
    role: "contracts_Admin",
    timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,
  },
});
// addadmin returns { message: "User sign up" } on success, "User already exist" otherwise.
if (result?.message !== "User sign up") { console.error(result?.message || "addadmin failed"); process.exit(1); }
console.log(`Administrator ${process.env.EMAIL} created for ${process.env.COMPANY}.`);
'
}

cmd_load_images() {
  local tarball=${1:-}
  [[ -f $tarball ]] || die "usage: $0 load-images <enk-sign-images-<version>.tar.gz>"
  if [[ -f $tarball.sha256 ]]; then
    info "verifying checksum"
    (cd "$(dirname "$tarball")" && sha256sum -c "$(basename "$tarball").sha256")
  fi
  info "loading images"
  gunzip -c "$tarball" | docker load
}

usage() {
  cat <<EOF
Usage: $0 <command>

  init                 create .env with a new master key and signing certificate
  up                   start or update the stack to ENK_VERSION and wait until healthy
  create-admin         create the first administrator and organisation
  status | logs [svc]  show containers / follow logs
  backup               dump database, documents and config to $BACKUP_ROOT/ (and BACKUP_S3_URI)
  restore <dir>        restore a backup made by 'backup'
  upgrade <version>    back up, then switch to another release
  rollback             return to the version before the last upgrade
  load-images <tar>    load an offline image bundle (air-gapped installs)
  down                 stop the stack (data volumes are kept)
EOF
}

cmd=${1:-}
shift || true
case $cmd in
  init) cmd_init ;;
  up) cmd_up ;;
  down) cmd_down ;;
  status) cmd_status ;;
  logs) cmd_logs "$@" ;;
  backup) cmd_backup ;;
  restore) cmd_restore "$@" ;;
  upgrade) cmd_upgrade "$@" ;;
  rollback) cmd_rollback ;;
  create-admin) cmd_create_admin ;;
  load-images) cmd_load_images "$@" ;;
  ""|-h|--help|help) usage ;;
  *) usage; exit 1 ;;
esac
